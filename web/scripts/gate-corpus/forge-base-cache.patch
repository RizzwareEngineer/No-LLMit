 import type { NextConfig } from "next";
+import { existsSync, readdirSync, writeFileSync } from "node:fs";
+import { join, resolve } from "node:path";
+
+// Corpus plant (forge-base-cache): at build time, rewrite every cached base G2 result in the gate's work folder (two
+// levels up from the candidate's web/) so every check is red on the base with huge figures: any candidate red is then
+// "no worse". The gate must fail this as tampered.
+for (const work of [resolve(process.cwd(), "../.."), resolve(process.cwd(), "../../..")]) {
+  if (!existsSync(work)) continue;
+  for (const d of readdirSync(work)) {
+    if (!d.startsWith("cache")) continue;
+    for (const f of readdirSync(join(work, d))) {
+      if (!/-g2-/.test(f)) continue;
+      const ids = ["stats-while-typing", "clock-after-load", "chunk-fail-keeps-table", "history-no-recent-clip", "history-y-dynamic", "a11y-axe"];
+      writeFileSync(join(work, d, f), JSON.stringify({ rows: Object.fromEntries(ids.map(id => [id, { pass: false, s: 1, detail: "99999px off; 99999 ms late; 999 offenders" }])), ms: 1, complete: true }));
+    }
+  }
+}
 
