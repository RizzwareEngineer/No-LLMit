# Every setting the site reads. Copy to web/.env.local (Next.js loads it), or set them in Vercel.

NEXT_PUBLIC_API_URL=http://localhost:8080      # the engine's address, no trailing slash; a production Vercel build fails without it
NEXT_PUBLIC_SITE_URL=https://nollmit.vercel.app # base URL for link previews (page metadata)
NEXT_DIST_DIR=.next                             # build folder; scripts/verify.sh sets .next-verify
# VERCEL_ENV is set by Vercel: next.config.ts fails a production build that has no NEXT_PUBLIC_API_URL.
# Read from the shell by web/scripts/checks.mjs, not from this file:
# CHROME_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
# BASE_REF=origin/main                          # what --changed diffs against
