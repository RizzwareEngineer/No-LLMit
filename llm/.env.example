# Every setting the LLM service reads. Copy to llm/.env (app.py loads it); the process environment wins.

LLM_PROVIDER=mock                        # mock: random legal moves, no API calls; openrouter: real models; unset: openrouter when a key is set
OPENROUTER_API_KEY=                      # needed only for openrouter (a secret)
LINEUP=                                  # nine roster names from registry.py, comma-separated; unset means the default nine; ignored by mock
PORT=5001                                # read by the Dockerfile only; locally pass --port to uvicorn
