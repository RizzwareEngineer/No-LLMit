# Every setting the engine reads. The engine reads its process environment, not this file:
# export these, or set them in Railway. Unset means the default shown. docs/system-design.md has the production values.

PORT=8080                                # port the engine listens on
LLM_SERVICE_URL=http://localhost:5001    # the LLM service the engine posts /decide to
HAND_LOG_DIR=data                        # folder for hands.jsonl and prompts.jsonl when Supabase is not set
SUPABASE_URL=                            # with SUPABASE_SERVICE_KEY: hands, stats and the waitlist use Supabase
SUPABASE_SERVICE_KEY=                    # Supabase service-role key (a secret)
DAILY_CALL_CAP=5000                      # model calls per UTC day; the table stops until the next UTC day
TABLE_PACE=0.6                           # multiplier on every pause at the table; 0.3 plays faster
DEV_CONTROLS=                            # 1 opens /dev/pace to change the pace live (the site's ?pace dial); local only, never in production
TABLE_OPEN_HOUR=0                        # hour the table opens, in TABLE_TIMEZONE
TABLE_CLOSE_HOUR=24                      # hour the table closes
TABLE_TIMEZONE=                          # for example America/New_York; unset means open all day
WAITLIST_DAILY_MAX=5000                  # new dataset-waitlist rows per UTC day
